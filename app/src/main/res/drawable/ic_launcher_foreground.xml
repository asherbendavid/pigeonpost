<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground for PigeonPost.
  Canvas: 108x108dp. Keep visual content within the centered 66dp safe
  zone (roughly x:21-87, y:21-87) since the outer ring gets masked/cropped
  differently across launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Envelope body -->
    <path
        android:fillColor="#FDF6EC"
        android:strokeColor="#C9A876"
        android:strokeWidth="1.2"
        android:pathData="M28,60 L80,60 L80,86 L28,86 Z" />

    <!-- Envelope flap (open, folded back) -->
    <path
        android:fillColor="#F0E4CF"
        android:strokeColor="#C9A876"
        android:strokeWidth="1.2"
        android:pathData="M28,60 L54,42 L80,60 Z" />

    <!-- Envelope flap crease shadow -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#C9A876"
        android:strokeWidth="1"
        android:pathData="M28,86 L54,68 L80,86" />

    <!-- Pigeon tail -->
    <path
        android:fillColor="#7C8A9C"
        android:pathData="M64,55 L76,60 L66,62 Z" />

    <!-- Pigeon body -->
    <path
        android:fillColor="#8E9CAD"
        android:pathData="M40,58
                 C40,48 47,40 57,40
                 C66,40 72,46 73,54
                 C74,58 72,61 68,62
                 C60,64 46,63 42,61
                 C40,60 40,59 40,58 Z" />

    <!-- Pigeon wing -->
    <path
        android:fillColor="#6E7B8C"
        android:pathData="M46,50
                 C50,47 58,46 63,50
                 C59,52 52,53 47,54
                 C46,53 46,51 46,50 Z" />

    <!-- Pigeon head -->
    <path
        android:fillColor="#9AA7B6"
        android:pathData="M36,44
                 C36,38 41,34 47,34
                 C53,34 57,38 57,43
                 C57,48 53,51 47,51
                 C41,51 36,48 36,44 Z" />

    <!-- Pigeon head sheen -->
    <path
        android:fillColor="#B7C1CC"
        android:pathData="M39,40 C39,37 42,35 45,35 C43,37 41,39 41,42 C40,41 39,40 39,40 Z" />

    <!-- Beak -->
    <path
        android:fillColor="#E8A23B"
        android:pathData="M34,44 L26,45.5 L34,48 Z" />

    <!-- Eye -->
    <path
        android:fillColor="#2E2E2E"
        android:pathData="M43,41.5 m-1.4,0 a1.4,1.4 0,1 1,2.8 0 a1.4,1.4 0,1 1,-2.8 0" />

    <!-- Feet on envelope edge -->
    <path
        android:fillColor="#E8A23B"
        android:strokeColor="#E8A23B"
        android:strokeWidth="1.2"
        android:pathData="M48,62 L46,66 M48,62 L50,66 M60,62 L58,66 M60,62 L62,66" />

</vector>